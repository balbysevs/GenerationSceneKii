<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SceneGenerator.Desktop.App"
             Name="SceneGen"
             xmlns:local="using:SceneGenerator.Desktop"
             RequestedThemeVariant="Light">


    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
             <Application.Resources>
                 <ResourceDictionary>
                     <ResourceDictionary.ThemeDictionaries>

                         <ResourceDictionary x:Key="Light">
                             <SolidColorBrush x:Key="AppBackground" Color="#F3F5F9" />
                             <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
                             <SolidColorBrush x:Key="PanelBorder" Color="#DDE2EB" />
                             <SolidColorBrush x:Key="TextPrimary" Color="#192235" />
                             <SolidColorBrush x:Key="TextSecondary" Color="#64748B" />
                             <SolidColorBrush x:Key="AppAccent" Color="#2563EB" />
                             <SolidColorBrush x:Key="SceneGridBrush" Color="#DEE4EF" />
                             <SolidColorBrush x:Key="SceneObstacleBrush" Color="#64748B" />
                             <SolidColorBrush x:Key="ErrorBrush" Color="#B91C1C" />
                         </ResourceDictionary>

                         <ResourceDictionary x:Key="Dark">
                             <SolidColorBrush x:Key="AppBackground" Color="#15161C" />
                             <SolidColorBrush x:Key="PanelBackground" Color="#1E2029" />
                             <SolidColorBrush x:Key="PanelBorder" Color="#383C4A" />
                             <SolidColorBrush x:Key="TextPrimary" Color="#ECECF3" />
                             <SolidColorBrush x:Key="TextSecondary" Color="#A8AFC2" />
                             <SolidColorBrush x:Key="AppAccent" Color="#9B7CFF" />
                             <SolidColorBrush x:Key="SceneGridBrush" Color="#3D4253" />
                             <SolidColorBrush x:Key="SceneObstacleBrush" Color="#CBD5E1" />
                             <SolidColorBrush x:Key="ErrorBrush" Color="#FF8585" />
                         </ResourceDictionary>

                     </ResourceDictionary.ThemeDictionaries>
                 </ResourceDictionary>
             </Application.Resources>
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#2563EB" />
                <ColorPaletteResources x:Key="Dark" Accent="#9B7CFF" />
            </FluentTheme.Palettes>
        </FluentTheme>
    </Application.Styles>
</Application>