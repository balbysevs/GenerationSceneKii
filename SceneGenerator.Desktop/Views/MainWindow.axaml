<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SceneGenerator.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SceneGenerator.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Генератор пространственных сцен"
        Width="1280"
        Height="800"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid Margin="16"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="12">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="16">

            <TextBlock Grid.Column="0"
                       Text="Генератор сцен"
                       Foreground="{DynamicResource AppAccent}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Content="{Binding ThemeButtonText}"
                    Command="{Binding ToggleThemeCommand}"
                    Foreground="{DynamicResource AppAccent}"
                    BorderBrush="{DynamicResource AppAccent}"
                    MinWidth="150"
                    HorizontalContentAlignment="Center"
                    VerticalAlignment="Center" />

        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="300,*,240"
              ColumnSpacing="12">

            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                <TextBlock Text="Параметры генерации"
                           FontSize="18"
                           FontWeight="SemiBold" />
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                <TextBlock Text="Просмотр сцены"
                           FontSize="18"
                           FontWeight="SemiBold" />
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                <TextBlock Text="Сцены"
                           FontSize="18"
                           FontWeight="SemiBold" />
            </Border>

        </Grid>

        <TextBlock Grid.Row="2"
                   Text="Готово к генерации"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="13" />

    </Grid>

</Window>
