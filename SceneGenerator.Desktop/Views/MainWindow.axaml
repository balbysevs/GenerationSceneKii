<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SceneGenerator.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SceneGenerator.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Генератор пространственных сцен"
        Width="1280"
        Height="800"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid Margin="16"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="12">

        <TextBlock Grid.Row="0"
                   Text="Генератор сцен"
                   FontSize="24"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="1"
              ColumnDefinitions="300,*,240"
              ColumnSpacing="12">

            <Border Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                <TextBlock Text="Параметры генерации"
                           FontSize="18"
                           FontWeight="SemiBold" />
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                <TextBlock Text="Просмотр сцены"
                           FontSize="18"
                           FontWeight="SemiBold" />
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                <TextBlock Text="Сцены"
                           FontSize="18"
                           FontWeight="SemiBold" />
            </Border>

        </Grid>

        <TextBlock Grid.Row="2"
                   Text="Готово к генерации"
                   FontSize="13" />

    </Grid>

</Window>
